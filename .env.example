# Cortexa 端点配置模板 —— 复制为 .env 后填写（放仓库根或 data_dir 下，自动探测）
# 支持任意 OpenAI 兼容云端：DeepSeek / 通义千问 / Kimi / one-api 中转 / 本地代理。
# 本系统不绑定任何一家供应商；留空则离线 hash 嵌入（零成本、可复现）。
#
# 优先级：显式构造参数 > 本文件 > 无前后缀环境变量（OPENAI_API_KEY 等）> 内置默认。

# ---- 参赛必设四键（一键合规，P0-1 + P2-5b；Docker 部署已固化，无需手设）----
# CORTEXA_SCENE=aml  （治理/增强/生命周期用 aml schema；novel 场景的中文事件词
#                     治理英文评测内容会空转，AML 维度 D 静默失效）
# CORTEXA_JOURNAL_MODE=eval（评测数据不留日志；app 会把 query/消息原文落库）
# CORTEXA_NOVEL_ADAPTER_ENABLED=false（领域适配器参赛必须关闭——adapter 关即 RARE-lite
#                     门控关，Search 路径纯读不写记忆桥）
# CORTEXA_ASYNC_ENHANCE_ENABLED=false（异步增强参赛建议关闭：最小模型面/预算确定性；
#                     真实使用保持 True 让实体/关系后台补全）

# ---- 存储与运行 ----
# 数据目录（SQLite + 向量缓存存放位置）
CORTEXA_DATA_DIR=./data
# 本服务对外鉴权（对应官方 Authentication：留空=无需认证；非空=要求 Authorization: Token/Bearer 或 X-Api-Key，三头任一）
CORTEXA_API_KEY=
# 任务流水：app=全量（真实使用，默认）| eval=内容脱敏（参赛评测，合规"评测数据不留日志"）| off=不记录
CORTEXA_JOURNAL_MODE=app
# 场景 schema：novel（默认，真实使用）| aml（参赛评测）| code | custom
CORTEXA_SCENE=novel

# ---- 语义嵌入（可选；填了 key 即自动启用真实语义检索）----
# 语义软通道三件套（启用方式 A，真实写前 recall 用；默认关闭保持离线 hash 零成本）：
#   CORTEXA_EMBEDDING_PROVIDER=openai   （本机 DeepSeek 端点 /embeddings 实测可用）
#   CORTEXA_SEMANTIC_CHANNEL=1          （检索加语义软通道，实库 11/11 实证）
#   python examples/semantic_index_build.py <库> --apply  （先建语义索引，自动备份）
# 或用 novel_loop.py context <章> --semantic；参赛/确定性体检不要开。
# 注意带 CORTEXA_ 前缀；无前后缀的 OPENAI_API_KEY / OPENAI_BASE_URL 同样兼容。
CORTEXA_OPENAI_API_KEY=
# OpenAI 兼容端点地址。示例：
#   DeepSeek:   https://api.deepseek.com/v1
#   通义:       https://dashscope.aliyuncs.com/compatible-mode/v1
#   Kimi:       https://api.moonshot.cn/v1
#   自建中转:   https://your-relay.example.com/v1
CORTEXA_OPENAI_BASE_URL=

# 嵌入模型与维度（维度红线：换模型须同步改维度，旧库向量不兼容需重建）
# AML 第二期开源方法榜硬规：Embedding 只允许 text-embedding-v4（阿里云百炼 compatible-mode）。
# 参赛若开语义通道请设：CORTEXA_EMBEDDING_MODEL=text-embedding-v4 + 百炼 BASE_URL/KEY；维度可保持 512
# （v4 支持 dimensions 截断，客户端自动下发）。不开则保持 hash（无嵌入模型，合规）。
CORTEXA_EMBEDDING_MODEL=text-embedding-3-small
CORTEXA_EMBEDDING_DIM=512
# hash=离线确定性 | openai=云端语义（有 key 时 facade 自动切 openai）
CORTEXA_EMBEDDING_PROVIDER=hash

# ---- 对话模型（可选；规则引擎兜底/语义级审计用）----
# 官方参赛口径固定 gpt-4o-mini；真实使用场景可配任意兼容模型
CORTEXA_LLM_MODEL=gpt-4o-mini
# LLM 行为档案（auto=按模型名自动匹配；也可显式 openai/deepseek/kimi）
# 档案驱动三类适配：推理余量(max_tokens) / temperature 兼容 / thinking 禁用参数——
# 换云端模型通常只改 CORTEXA_LLM_MODEL 即可，档案自动跟随（新增模型见 llm/profiles.py）
CORTEXA_LLM_PROFILE=auto
# 推理模型最小补全 token（reasoning 先消耗配额；deepseek/kimi 实测需 >=384 才稳定）
CORTEXA_LLM_MIN_COMPLETION_TOKENS=128